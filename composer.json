{
    "name": "benabee/product-manager-connector",
    "description": "Connector extension for Product Manager for Magento",
    "type": "magento2-module",
    "version": "1.2.6",
    "license": "OSL-3.0",
    "authors": [
        {
            "name": "Maxime Coudreuse",
            "homepage": "https://www.benabee.com/",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "magento/framework": ">=102.0.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Benabee\\ProductManagerConnector\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
